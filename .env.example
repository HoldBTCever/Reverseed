# String de conexão do Postgres. Para desenvolvimento local mais simples, use
# um banco gratuito na nuvem (ex: neon.tech) — veja o README para o passo a passo.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Gere um valor aleatório: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
SESSION_SECRET=""

# Credenciais do usuário administrador (corretor), usadas por prisma/seed.ts.
ADMIN_EMAIL="corretor@example.com"
ADMIN_PASSWORD="troque-esta-senha"
ADMIN_NAME="Corretor"
